{
  "lastChangelogVersion": "0.85.1",
  "theme": "dark",
  "defaultProvider": "<your-provider>",
  "defaultModel": "<your-default-model>",
  "defaultThinkingLevel": "<your-thinking-level>",
  "hideThinkingBlock": true,
  "defaultProjectTrust": "ask",
  "packages": [
    "npm:pi-observational-memory",
    "npm:pi-lazy-evo",
    "npm:pi-context-inspector",
    "npm:pi-chrome",
    "npm:pi-jingle",
    "npm:@narumitw/pi-btw",
    "npm:@narumitw/pi-usage",
    "npm:@juicesharp/rpiv-web-tools",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-rtk-optimizer"
  ],
  "showHardwareCursor": true,
  "enabledModels": [],
  "doubleEscapeAction": "tree",
  "observational-memory": {
    "compactAfterTokensMode": "calibrated",
    "compactAfterTokens": 81000,
    "model": {
      "provider": "<your-cheap-model-provider>",
      "id": "<your-cheap-model-id>",
      "thinking": "low"
    }
  },
  "treeFilterMode": "all",
  "sounds": {
    "agent_end": "~/.pi/agent/sounds/hey_listen_navi.wav"
  },
  "markdown": {
    "mermaid": "streaming"
  },
  "tuiMode": "regular",
  "editorPaddingX": 0
}
