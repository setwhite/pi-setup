{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "theme": "dark",
  "defaultProvider": "<your-provider>",
  "defaultModel": "<your-default-model>",
  "defaultThinkingLevel": "<your-thinking-level>",
  "hideThinkingBlock": false,
  "defaultProjectTrust": "ask",
  "packages": [
    "npm:pi-jingle",
    "npm:@narumitw/pi-btw",
    "npm:@narumitw/pi-usage",
    "npm:pi-context-view",
    "npm:@ssk_dev/rpiv-ask-user-question-lean",
    "npm:@ssk_dev/rpiv-todo-lean",
    "npm:pi-blackhole",
    "npm:pi-chrome",
    "npm:pi-web-search-lite"
  ],
  "showHardwareCursor": false,
  "enabledModels": [],
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "sounds": {
    "agent_end": "~/.pi/agent/sounds/hey_listen_navi.wav"
  },
  "markdown": {
    "mermaid": "streaming"
  },
  "tuiMode": "fullscreen",
  "editorPaddingX": 0,
  "modelThinkingLevels": {},
  "cacheWarming": "streaming",
  "compaction": {
    "enabled": true
  },
  "autocompleteMaxVisible": 5,
  "fullscreenExitOutput": "transcript",
  "fullscreenScrollbar": "hidden",
  "fullscreenCopyOnSelect": false,
  "fullscreenWheelScrollLines": "auto",
  "codemode": {
    "mode": "on"
  },
  "defaultTools": [
    "+codemode"
  ]
}
