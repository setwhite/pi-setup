{
  "theme": "dark",
  "defaultProvider": "<your-provider>",
  "defaultModel": "<your-default-model>",
  "defaultThinkingLevel": "<your-thinking-level>",
  "hideThinkingBlock": false,
  "defaultProjectTrust": "ask",
  "packages": [
    "npm:pi-chrome",
    "npm:pi-jingle",
    "npm:@narumitw/pi-btw",
    "npm:@narumitw/pi-usage",
    "npm:pi-context-view",
    "npm:@ssk_dev/rpiv-ask-user-question-lean",
    "npm:@juicesharp/rpiv-web-tools",
    "npm:@ssk_dev/rpiv-todo-lean",
    "npm:pi-blackhole"
  ],
  "showHardwareCursor": false,
  "enabledModels": [],
  "modelThinkingLevels": {},
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "sounds": {
    "agent_end": "~/.pi/agent/sounds/hey_listen_navi.wav"
  },
  "markdown": {
    "mermaid": "streaming"
  },
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "hidden",
  "fullscreenCopyOnSelect": false,
  "editorPaddingX": 0,
  "cacheWarming": "streaming",
  "defaultTools": ["+codemode"]
}
